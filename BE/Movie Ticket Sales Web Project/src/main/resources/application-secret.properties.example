# ==========================================
# HƯỚNG DẪN: Copy file này thành application-secret.properties
# Đường dẫn: BE/Movie Ticket Sales Web Project/src/main/resources/application-secret.properties
# Điền giá trị thật vào các dòng bên dưới
# ==========================================

# JWT Secret (ít nhất 32 ký tự)
app.jwt.secret=YOUR_JWT_SECRET_HERE

# AWS S3
aws.s3.access-key=YOUR_AWS_ACCESS_KEY
aws.s3.secret-key=YOUR_AWS_SECRET_KEY

# Email (Gmail App Password)
spring.mail.username=your-email@gmail.com
spring.mail.password=YOUR_APP_PASSWORD

# Gemini API Key (lấy tại https://aistudio.google.com/apikey)
gemini.api.key=YOUR_GEMINI_API_KEY
